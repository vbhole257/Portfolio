# ==============================================================================
# Portfolio Environment Variables
# ==============================================================================

# Contact Form Email Configuration (SMTP)
SMTP_EMAIL=vbhole257@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# ==============================================================================
# Razorpay "Buy Me a Coffee" Configuration
# ==============================================================================
# Public Key ID (Required on Frontend & Backend)
# For Test Mode: starts with "rzp_test_"
# For Live Mode: starts with "rzp_live_"
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere

# Secret Key (Strictly Server-Only! NEVER expose this with NEXT_PUBLIC_)
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Webhook Secret (Configured inside Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretStringHere
